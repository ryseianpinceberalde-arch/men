{
  "Agent": {
    "HeartbeatSeconds": 45,
    "PollSeconds": 15,
    "HardwareRefreshMinutes": 30,
    "MaximumInventoryRows": 2500,
    "ApprovedServiceNames": [],
    "DeniedServiceNames": [
      "RpcSs", "DcomLaunch", "EventLog", "Winmgmt", "WinDefend", "MpsSvc", "PlugPlay", "SamSs", "LSM", "Schedule"
    ],
    "DeniedProcessNames": [
      "System", "System Idle Process", "smss.exe", "csrss.exe", "wininit.exe", "services.exe", "lsass.exe", "winlogon.exe", "svchost.exe"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
