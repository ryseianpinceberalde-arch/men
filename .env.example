# Copy to supabase/.env for local Edge Function development when required.
# Hosted Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY into Edge Functions. Never put a service-role key
# in dashboard/config.js or the Windows agent.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
